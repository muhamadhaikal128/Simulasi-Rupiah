. **## 9.7 Forecast akhir dan PIP sampel penuh (origin = final_origin)
. use "$data\bma_data.dta", clear

. local ir = $final_origin - mdate[1] + 1

. foreach v of global bma_preds {
  2.         if missing(`v'[`ir']) {
  3.                 di as error "BMA: prediktor `v' kosong pada final_origin"
  4.                 exit 459
  5.         }
  6. }

. local s0 = usdidr[`ir']

. tempname pf pp

. postfile `pf' h mdate mean_pct sd_pct median lower95 lower80 upper80 upper95 using "$data\bma_final.dta", replace

. postfile `pp' str8 predictor h pip using "$data\bma_pip_final.dta", replace

. foreach h of global horizons {
  2.         bv_bma_one `h' $final_origin $bma_best_g
  3.         local m = r(yhat)
  4.         local s = r(ysd)
  5.         foreach v of global bma_preds {
  6.                 post `pp' ("`v'") (`h') (r(pip_`v'))
  7.         }
  8.         * interval: pendekatan normal untuk campuran predictive (mean dan sd analitis BMA)
.         post `pf' (`h') ($final_origin + `h') (`m') (`s') (`s0'*exp(`m'/100)) ///
>                 (`s0'*exp((`m' - invnormal(0.975)*`s')/100)) (`s0'*exp((`m' - invnormal(0.90)*`s')/100)) ///
>                 (`s0'*exp((`m' + invnormal(0.90)*`s')/100)) (`s0'*exp((`m' + invnormal(0.975)*`s')/100))
  9.         * model teratas (probabilitas posterior model)
.         di as txt _n "BMA h = `h': 10 model dengan probabilitas posterior tertinggi"
 10.         bmastats models, top(10)
 11.         tempname S V
 12.         matrix `S' = r(summary)
 13.         matrix `V' = r(varinclmat)
 14.         preserve
 15.                 clear
 16.                 mata: bma_mat2data("`S'")
 17.                 gen rank = _n
 18.                 bv_out tab "B6_bma_top_models_h`h'"
 19.                 clear
 20.                 mata: bma_mat2data("`V'")
 21.                 bv_out diag "B6_bma_varinclusion_h`h'"
 22.         restore
 23. }

