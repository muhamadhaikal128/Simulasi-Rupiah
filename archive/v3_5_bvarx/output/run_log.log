. * SD, Ljung-Box Q(12) dan uji normalitas (skewness/kurtosis) per persamaan
. tempname pr

. postfile `pr' str10 equation N sd lb_q12 lb_p12 sk_skew_p sk_kurt_p sk_joint_p ///
>         using "$data\residual_tests.dta", replace

. foreach v in res_s res_tb res_flows res_res {
  2.         qui sum `v'
  3.         local sd = r(sd)
  4.         local N = r(N)
  5.         qui wntestq `v', lags(12)
  6.         local q = r(stat)
  7.         local qp = r(p)
  8.         * sktest: r(Utest) = (Pr skewness, Pr kurtosis, chi2, Prob>chi2)
.         local skp .
  9.         local kup .
 10.         local jp .
 11.         cap qui sktest `v'
 12.         if !_rc {
 13.                 tempname U
 14.                 matrix `U' = r(Utest)
 15.                 local skp = `U'[1, 1]
 16.                 local kup = `U'[1, 2]
 17.                 local jp = `U'[1, colsof(`U')]
 18.         }
 19.         post `pr' ("`v'") (`N') (`sd') (`q') (`qp') (`skp') (`kup') (`jp')
 20. }

. postclose `pr'

