. **## 9.3 Program: backtest untuk daftar origin dan satu g (hasil di-append ke file)
. cap program drop bv_bma_bt

. program define bv_bma_bt
  1.         args g period o1 o2 file
  2.         local pipv ""
  3.         local pipe ""
  4.         foreach v of global bma_preds {
  5.                 local pipv `pipv' pip_`v'
  6.                 local pipe `pipe' (r(pip_`v'))
  7.         }
  8.         use "$data\bma_data.dta", clear
  9.         local first = mdate[1]
 10.         tempname pb
 11.         postfile `pb' str6 g str12 period origin h n actual rw yhat ysd yact `pipv' using "`file'", replace
 12.         forval r = `o1'/`o2' {
 13.                 local ir = `r' - `first' + 1
 14.                 foreach h of global horizons {
 15.                         local act = usdidr[`ir' + `h']
 16.                         local s0 = usdidr[`ir']
 17.                         bv_bma_one `h' `r' `g'
 18.                         post `pb' ("`g'") ("`period'") (`r') (`h') (r(n)) (`act') (`s0') (r(yhat)) (r(ysd)) ///
>                                 (100*ln(`act'/`s0')) `pipe'
 19.                 }
 20.         }
 21.         postclose `pb'
 22. end

. 
. **## 9.4 Program: skor per horizon (RMSE, relatif RW, arah, DM-HLN, Clark-West)
. cap program drop bv_bma_score

. program define bv_bma_score
  1.         gen double point = rw*exp(yhat/100)
  2.         gen double e_m = (actual - point)^2
  3.         gen double e_r = (actual - rw)^2
  4.         gen double dl = e_m - e_r
  5.         gen double cwf = yact^2 - ((yact - yhat)^2 - yhat^2)
  6.         gen double dirok = sign(yhat) == sign(yact)
  7.         tempfile base res
  8.         save `base'
  9.         tempname ps
 10.         postfile `ps' horizon n rmse_bma rmse_rw relative_rmse direction dm_hln dm_p cw_t cw_p using `res'
 11.         foreach h of global horizons {
 12.                 use `base', clear
 13.                 keep if h == `h'
 14.                 sort origin
 15.                 qui sum e_m
 16.                 local mm = r(mean)
 17.                 local n = r(N)
 18.                 qui sum e_r
 19.                 local mr = r(mean)
 20.                 qui sum dirok
 21.                 local dir = r(mean)
 22.                 mata: st_local("dm", strofreal(bma_nwt(st_data(., "dl"), `h' - 1), "%20.0g"))
 23.                 mata: st_local("cw", strofreal(bma_nwt(st_data(., "cwf"), `h' - 1), "%20.0g"))
 24.                 local hln = `dm'*sqrt((`n' + 1 - 2*`h' + `h'*(`h' - 1)/`n')/`n')
 25.                 post `ps' (`h') (`n') (sqrt(`mm')) (sqrt(`mr')) (sqrt(`mm'/`mr')) (`dir') ///
>                         (`hln') (2*ttail(`n' - 1, abs(`hln'))) (`cw') (1 - normal(`cw'))
 26.         }
 27.         postclose `ps'
 28.         use `res', clear
 29. end

