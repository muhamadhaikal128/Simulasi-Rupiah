. **## 9.2 Program: satu estimasi BMA untuk horizon h, origin r, nilai g
. cap program drop bv_bma_one

. program define bv_bma_one, rclass
  1.         args h r g
  2.         local gopt = cond("`g'" == "n", "gprior(uip)", "gprior(fixed `g')")
  3.         qui bmaregress y`h' $bma_preds if mdate + `h' <= `r' & mdate >= ym($bma_start, 1), ///
>                 mprior(binomial $bma_inc) `gopt' notable noheader
  4.         return scalar n = e(N)
  5.         tempname P
  6.         matrix `P' = e(pip)
  7.         foreach v of global bma_preds {
  8.                 local j = colnumb(`P', "`v'")
  9.                 if !missing(`j') return scalar pip_`v' = `P'[1, `j']
 10.                 else {
 11.                         local j = rownumb(`P', "`v'")
 12.                         return scalar pip_`v' = `P'[`j', 1]
 13.                 }
 14.         }
 15.         cap drop _bma_m _bma_s
 16.         qui bmapredict _bma_m if mdate == `r', mean
 17.         qui bmapredict _bma_s if mdate == `r', std
 18.         qui sum _bma_m if mdate == `r'
 19.         return scalar yhat = r(mean)
 20.         qui sum _bma_s if mdate == `r'
 21.         return scalar ysd = r(mean)
 22.         drop _bma_m _bma_s
 23. end

. 
. * Statistik t Newey-West (Bartlett, lag L) untuk rata-rata x
. mata:
------------------------------------------------- mata (type end to exit) --------------------------------------------
: real scalar bma_nwt(real colvector x, real scalar L)
> {
>         real colvector e
>         real scalar n, m, v, l
>         n = rows(x)
>         m = mean(x)
>         e = x :- m
>         v = sum(e:^2)/n
>         for (l = 1; l <= min((L, n - 1)); l++) {
>                 v = v + 2*(1 - l/(L + 1))*sum(e[|l+1 \ n|] :* e[|1 \ n-l|])/n
>         }
>         return(m/sqrt(v/n))
> }

: 
: // Matriks Stata -> dataset: kolom "row" = nama baris, kolom lain = nama kolom (dibuat valid)
: void bma_mat2data(string scalar name)
> {
>         real matrix M
>         string colvector rs, cs
>         string scalar v
>         real scalar j
>         M  = st_matrix(name)
>         rs = st_matrixrowstripe(name)[., 2]
>         cs = st_matrixcolstripe(name)[., 2]
>         stata("clear")
>         st_addobs(rows(M))
>         (void) st_addvar("str32", "row")
>         st_sstore(., "row", rs)
>         for (j = 1; j <= cols(M); j++) {
>                 v = strtoname(cs[j])
>                 if (v == "" | v == "row" | _st_varindex(v) < .) v = "c" + strofreal(j)
>                 (void) st_addvar("double", v)
>                 st_store(., v, M[., j])
>         }
> }

: end
----------------------------------------------------------------------------------------------------------------------

