. **## 1.6 Unit root: ADF dan Phillips-Perron, sampel 2014+ dengan data inti lengkap
. * H0 = unit root. p < 0,05 -> tolak H0 (stasioner). Pembenaran model changes: level kurs, cadangan,
. * DXY diharapkan unit root, perubahannya stasioner. Bukan bukti kointegrasi.
. * Lag ADF 0-6 dipilih dengan BIC pada sampel bersama (setara ur.df selectlags = "BIC").
. * Tiap seri dibungkus capture: satu seri gagal tidak menghentikan run; progres dicetak per seri.
. if $run_adf {
. preserve
.         keep if year >= 2014 & complete_check == 1
(13 observations deleted)
.         tsset mdate, monthly

Time variable: mdate, 2014m1 to 2026m8
        Delta: 1 month
.         gen double l_usdidr = ln(usdidr)
.         gen double l_res = ln(fx_reserves_usdbn)
.         gen double l_dxy = ln(dxy)
.         gen double d_l_usdidr = D.l_usdidr
(1 missing value generated)
.         gen double d_l_res = D.l_res
(1 missing value generated)
.         gen double d_l_dxy = D.l_dxy
(1 missing value generated)
.         gen double tb = trade_bal_usdbn
.         gen double flows = net_flows_idrtn
.         gen double trend_t = _n
.         tempname pu
.         postfile `pu' str16 series str8 det lags N adf_tau adf_p pp_z pp_p rc using "$data\unit_root.dta", replace
.         * level dengan trend; perubahan dan arus dengan konstanta saja
.         foreach spec in "l_usdidr trend" "d_l_usdidr drift" "l_res trend" "d_l_res drift" ///
>                 "l_dxy trend" "d_l_dxy drift" "tb drift" "flows drift" {
  2.                 gettoken v det : spec
  3.                 local det = strtrim("`det'")
  4.                 local tr = cond("`det'" == "trend", "trend_t", "")
  5.                 local ppopt = cond("`det'" == "trend", "trend", "")
  6.                 di as txt "Unit root: `v' (`det')"
  7.                 local best .
  8.                 local N .
  9.                 local tau .
 10.                 local p .
 11.                 local ppz .
 12.                 local ppp .
 13.                 capture noisily {
 14.                         * sampel bersama untuk semua lag (lag maksimum 6)
.                         qui regress D.`v' L.`v' `tr' L(1/6)D.`v'
 15.                         tempvar s
 16.                         qui gen byte `s' = e(sample)
 17.                         local best 0
 18.                         local bic_best = .
 19.                         forval k = 0/6 {
 20.                                 if `k' == 0 qui regress D.`v' L.`v' `tr' if `s'
 21.                                 else qui regress D.`v' L.`v' `tr' L(1/`k')D.`v' if `s'
 22.                                 local bic = -2*e(ll) + e(rank)*ln(e(N))
 23.                                 if `bic' < `bic_best' {
 24.                                         local bic_best = `bic'
 25.                                         local best = `k'
 26.                                 }
 27.                         }
 28.                         qui dfuller `v', `det' lags(`best')
 29.                         local N = r(N)
 30.                         local tau = r(Zt)
 31.                         local p = r(p)
 32.                         qui pperron `v', `ppopt' lags(4)
 33.                         local ppz = r(Zt)
 34.                         local ppp = r(p)
 35.                 }
 36.                 local rc = _rc
 37.                 post `pu' ("`v'") ("`det'") (`best') (`N') (`tau') (`p') (`ppz') (`ppp') (`rc')
 38.         }
Unit root: l_usdidr (trend)
Unit root: d_l_usdidr (drift)
Unit root: l_res (trend)
Unit root: d_l_res (drift)
Unit root: l_dxy (trend)
Unit root: d_l_dxy (drift)
Unit root: tb (drift)
Unit root: flows (drift)
.         postclose `pu'
.         use "$data\unit_root.dta", clear
.         gen str28 adf_conclusion = cond(rc != 0, "gagal dihitung", cond(adf_p < 0.05, "stasioner (tolak H0)", "unit 
> root (gagal tolak H0)"))
.         gen str28 pp_conclusion = cond(rc != 0, "gagal dihitung", cond(pp_p < 0.05, "stasioner (tolak H0)", "unit ro
> ot (gagal tolak H0)"))
.         format adf_tau adf_p pp_z pp_p %8.3f
.         list, noobs clean

