. mata: D = bv_load("levels")

. 
. tempname pv

. postfile `pv' start_year p double lambda score rrmse_h1 rrmse_h3 rrmse_h6 min_ess_ratio ///
>         using "$data\validation_grid.dta", replace

. tempfile allbt

. local first 1

. foreach sy of global grid_start {
  2.         foreach p of global grid_p {
  3.                 foreach lam of global grid_lambda {
  4.                         di as txt "Validation: start=`sy' p=`p' lambda=`lam'"
  5.                         mata: R = bv_backtest(D, `sy', `p', `lam', $include_ust, ($val_from::$val_to), ///
>                                 $n_val, 10000, $release_lag, hz)
  6.                         mata: bv_tostata(R, bv_bt_names())
  7.                         gen start_year = `sy'
  8.                         gen p = `p'
  9.                         gen double lambda = `lam'
 10.                         if !`first' append using `allbt'
 11.                         save `allbt', replace
 12.                         local first 0
 13.                         keep if start_year == `sy' & p == `p' & lambda == `lam'
 14.                         bv_score
 15.                         qui sum relative_rmse
 16.                         local sc = r(mean)
 17.                         forval i = 1/3 {
 18.                                 local r`i' = relative_rmse[`i']
 19.                         }
 20.                         qui sum min_ess_ratio
 21.                         post `pv' (`sy') (`p') (`lam') (`sc') (`r1') (`r2') (`r3') (r(min))
 22.                 }
 23.         }
 24. }
