 12.         if !_rc {
 13.                 tempname U
 14.                 matrix `U' = r(Utest)
 15.                 local skp = `U'[1, 1]
 16.                 local kup = `U'[1, 2]
 17.                 local jp = `U'[1, colsof(`U')]
 18.         }
 19.         post `pr' ("`v'") (`N') (`sd') (`q') (`qp') (`skp') (`kup') (`jp')
 20. }

