.         foreach spec in "l_usdidr trend" "d_l_usdidr drift" "l_res trend" "d_l_res drift" ///
>                 "l_dxy trend" "d_l_dxy drift" "tb drift" "flows drift" {
  2.                 gettoken v det : spec
  3.                 local det = strtrim("`det'")
  4.                 local tr = cond("`det'" == "trend", "trend_t", "")
  5.                 local ppopt = cond("`det'" == "trend", "trend", "")
  6.                 di as txt "Unit root: `v' (`det')"
  7.                 local best .
  8.                 local N .
  9.                 local tau .
 10.                 local p .
 11.                 local ppz .
 12.                 local ppp .
 13.                 capture noisily {
 14.                         * sampel bersama untuk semua lag (lag maksimum 6)
.                         qui regress D.`v' L.`v' `tr' L(1/6)D.`v'
 15.                         tempvar s
 16.                         qui gen byte `s' = e(sample)
 17.                         local best 0
 18.                         local bic_best = .
 19.                         forval k = 0/6 {
 20.                                 if `k' == 0 qui regress D.`v' L.`v' `tr' if `s'
 21.                                 else qui regress D.`v' L.`v' `tr' L(1/`k')D.`v' if `s'
 22.                                 local bic = -2*e(ll) + e(rank)*ln(e(N))
 23.                                 if `bic' < `bic_best' {
 24.                                         local bic_best = `bic'
 25.                                         local best = `k'
 26.                                 }
 27.                         }
 28.                         qui dfuller `v', `det' lags(`best')
 29.                         local N = r(N)
 30.                         local tau = r(Zt)
 31.                         local p = r(p)
 32.                         qui pperron `v', `ppopt' lags(4)
 33.                         local ppz = r(Zt)
 34.                         local ppp = r(p)
 35.                 }
 36.                 local rc = _rc
 37.                 post `pu' ("`v'") ("`det'") (`best') (`N') (`tau') (`p') (`ppz') (`ppp') (`rc')
 38.         }
