. **## 7.3 Narasi hasil (terisi otomatis)
. use "$data\test_scores_levels.dta", clear

. tempname fh

. file open `fh' using "$results\narasi_hasil.txt", write replace text

. file write `fh' "NARASI HASIL (draft otomatis, profile = $profile)" _n _n

. file write `fh' "Spesifikasi terpilih dalam grid menggunakan awal sampel $best_start, lag $best_p, dan lambda " %4.2f 
> ($best_lambda) ". "

. file write `fh' "Pemilihannya menggunakan validation, sedangkan hasil berikut berasal dari test yang terpisah." _n _n

. forval i = 1/`=_N' {
  2.         file write `fh' "Pada horizon " %1.0f (horizon[`i']) " bulan, relative RMSE adalah " %5.3f (relative_rmse[`
> i'])
  3.         file write `fh' ", dengan RMSE BVARX " %7.1f (rmse_bvar[`i']) " dan RW " %7.1f (rmse_rw[`i']) " rupiah per 
> USD. "
  4.         if relative_rmse[`i'] < 1 file write `fh' "BVARX mempunyai error lebih kecil secara deskriptif pada horizon
>  ini. "
  5.         else file write `fh' "Random walk mempunyai error lebih kecil secara deskriptif pada horizon ini. "
  6.         file write `fh' "Coverage 80%/95%: " %4.2f (coverage80[`i']) "/" %4.2f (coverage95[`i']) ". "
  7.         file write `fh' "Temuan ini belum menyatakan keunggulan signifikan dan tetap bergantung pada information se
> t serta vintage data." _n _n
  8. }

. use "$data\test_bootstrap.dta", clear

. keep if block == 6
(6 observations deleted)

. forval i = 1/`=_N' {
  2.         file write `fh' "Bootstrap (blok 6) h=" %1.0f (horizon[`i']) ": interval 95% relative RMSE " %5.3f (lower[`
> i']) "-" %5.3f (upper[`i'])
  3.         if covers_one[`i'] file write `fh' " (meliputi 1: belum ada bukti kuat mengungguli RW)." _n
  4.         else file write `fh' " (tidak meliputi 1)." _n
  5. }

. file write `fh' _n

. use "$data\scenario_spot.dta", clear

. keep if mdate == $final_origin + $H_final
(15 observations deleted)

. forval i = 1/`=_N' {
  2.         local sc : label scen `=scenario[`i']'
  3.         file write `fh' "Skenario `sc': median USD/IDR pada `: di %tmMon_CCYY $final_origin + $H_final' adalah " %7
> .0f (median[`i'])
  4.         file write `fh' ", dengan rentang predictive 80% " %7.0f (lower80[`i']) "-" %7.0f (upper80[`i']) "." _n
  5. }

. file write `fh' _n "Bersyarat pada jalur DXY dan pembatasan observabel yang dijelaskan. Skenario adalah proyeksi bersa
> ma model, bukan estimasi efek kausal tunggal." _n

. file close `fh'

. type "$results\narasi_hasil.txt"
NARASI HASIL (draft otomatis, profile = standard)

